{
  "extends": "./tsconfig.backend.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "Node16",
    "moduleResolution": "Node16",
    "allowImportingTsExtensions": false,
    "rootDir": "backend",
    "outDir": "dist-backend",
    "sourceMap": true
  },
  "include": ["backend/**/*.ts"],
  "exclude": ["node_modules", "dist", "frontend", "tests"]
}
