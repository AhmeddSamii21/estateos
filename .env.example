# Environment Variables for EstateOS Team
# Copy this file to .env and fill in your values

# Server Configuration
NODE_ENV=development
PORT=3000
HOST=localhost

# Database Configuration
DATABASE_URL="postgresql://username:password@localhost:5432/estateos"

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here
JWT_EXPIRES_IN=7d

# File Upload Configuration
# Keep uploaded business documents outside the public web root.
UPLOAD_PATH=./storage/documents
MAX_FILE_SIZE=10485760  # 10MB in bytes
ALLOWED_FILE_TYPES=application/pdf,image/jpeg,image/png,text/plain,text/csv,application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000  # 15 minutes
RATE_LIMIT_MAX_REQUESTS=100

# Email Configuration (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Company Configuration
COMPANY_NAME=EstateOS Team
COMPANY_EMAIL=info@estateos.com
COMPANY_PHONE=+1-555-123-4567
DEFAULT_LANGUAGE=en
DEFAULT_CURRENCY=USD

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your-session-secret-here
CSRF_SECRET=your-csrf-secret-here

# Outbound Webhooks (Package 22)
# Pepper used to derive HMAC signing keys from stored endpoint secret hashes.
# Keep it stable across restarts so receivers can verify existing endpoints.
WEBHOOK_SIGNING_KEY=replace-with-a-long-random-signing-key
# Development/testing ONLY. Never enable in production (ignored when NODE_ENV=production).
WEBHOOK_ALLOW_PRIVATE_URLS=false
# Per-request receiver timeout in milliseconds (500-30000)
WEBHOOK_TIMEOUT_MS=5000

# Development Only
DEV_MODE=true
DEBUG=true