// EstateOS Team - Prisma schema
// Standard Prisma Schema Language (PostgreSQL)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Roles are derived from the application requirements (Admin, Manager,
// Agent, Accountant, Team Lead) and the existing User.role default (AGENT).
enum Role {
  ADMIN
  MANAGER
  AGENT
  ACCOUNTANT
  // Package 27: sees own records plus the records of their team and branch.
  TEAM_LEAD
}

// Registration-approval lifecycle for user accounts.
enum AccountStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

// Values used by backend/routes/properties.ts and the legacy locator app.
enum PropertyType {
  HOUSE
  APARTMENT
  CONDO
  TOWNHOUSE
  VILLA
  LAND
  COMMERCIAL
}

enum PropertyStatus {
  AVAILABLE
  PENDING
  RESERVED
  SOLD
  RENTED
  OFF_MARKET
  UNAVAILABLE
  UNDER_NEGOTIATION
}

enum PropertyClassification {
  SALE
  RENT
}

enum AreaUnit {
  SQ_M
  SQ_FT
}

enum PropertyCondition {
  NEW
  EXCELLENT
  GOOD
  FAIR
  POOR
  UNDER_CONSTRUCTION
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  VIEWING
  NEGOTIATION
  WON
  LOST
}

enum AppointmentStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum AppointmentType {
  VIEWING
  MEETING
  CALL
}

enum DealStatus {
  DRAFT
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum DealType {
  SALE
  RENT
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum ExpenseStatus {
  PENDING
  PAID
  CANCELLED
}

enum CommissionStatus {
  PENDING
  APPROVED
  PAID
  CANCELLED
}

enum DocumentStatus {
  ACTIVE
  ARCHIVED
}

// Package 22: outbound webhook delivery lifecycle. The four public event
// codes live in backend/utils/webhookEvents.ts; this enum only tracks the
// transport state of a single delivery attempt.
enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
  RETRYING
}

// Package 14: property floorplans and brochures share the document table but
// are distinguished by kind so existing document integrations stay unchanged.
enum PropertyAttachmentKind {
  OTHER
  FLOORPLAN
  BROCHURE
}

// Package 15: persisted lead priority tiers, derived from source, budget,
// completeness, status and follow-up timing.
enum LeadPriorityTier {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// Package 17: payment aging is derived from due dates so historical rows do
// not need to be rewritten when a bucket boundary passes. The public bucket
// values are CURRENT, 1_30_DAYS, 31_60_DAYS, 60_PLUS_DAYS and PAID.

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// Package 18: recurring maintenance cycles. NONE preserves every legacy row;
// completed recurring rows spawn the next cycle with a fresh due date.
enum MaintenanceRecurrenceInterval {
  NONE
  MONTHLY
  QUARTERLY
  SEMI_ANNUAL
}

// Package 18: owner payouts are tracked separately from owner statements so
// historical statement figures remain unchanged when a payout is settled.
enum OwnerPayoutStatus {
  PENDING
  SETTLED
  CANCELLED
}

enum OccupancyStatus {
  VACANT
  OWNER_OCCUPIED
  TENANT_OCCUPIED
}

model Organization {
  id            String    @id @default(uuid())
  name          String
  slug          String    @unique
  description   String?
  address       String?
  phone         String?
  email         String?
  website       String?
  logoUrl       String?
  currency      String    @default("USD")
  baseCurrency  String    @default("USD")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  isActive      Boolean   @default(true)

  users         User[]
  properties    Property[]
  owners        Owner[]
  deals         Deal[]
  settings      Settings?
  currencies    Currency[]
  exchangeRates ExchangeRate[]
  documents     Document[]
  ownerPayouts  OwnerPayout[]
  maintenanceRequests MaintenanceRequest[]
  notifications Notification[]
  webhookEndpoints WebhookEndpoint[]
  webhookDeliveries WebhookDelivery[]
  // Package 27: tenant-scoped team/branch hierarchy.
  branches      Branch[]
  teams         Team[]
}

// Package 27: a branch groups teams and users. All rows stay inside one tenant.
model Branch {
  id             String    @id @default(uuid())
  organizationId String
  name           String
  nameAr         String?
  code           String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  teams        Team[]
  users        User[]
  properties   Property[]
  leads        Lead[]
  deals        Deal[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

// Package 27: a team belongs to a branch and has an optional leader.
model Team {
  id             String    @id @default(uuid())
  organizationId String
  branchId       String?
  name           String
  nameAr         String?
  leaderId       String?
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])
  leader       User?        @relation("TeamLeader", fields: [leaderId], references: [id])
  members      User[]       @relation("TeamMembers")
  properties   Property[]
  leads        Lead[]
  deals        Deal[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([branchId])
}

model Currency {
  id             String    @id @default(uuid())
  code           String
  name           String
  symbol         String
  decimals       Int       @default(2)
  isEnabled      Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  fromRates      ExchangeRate[] @relation("ExchangeRateFrom")
  toRates        ExchangeRate[] @relation("ExchangeRateTo")

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Historical exchange-rate snapshots: rates are never recalculated
// retroactively, so every row keeps its own effective date.
model ExchangeRate {
  id             String    @id @default(uuid())
  organizationId String?
  fromCurrencyId String
  toCurrencyId   String
  rate           Decimal   @db.Decimal(20, 8)
  effectiveAt    DateTime  @default(now())
  createdAt      DateTime  @default(now())
  note           String?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  fromCurrency   Currency @relation("ExchangeRateFrom", fields: [fromCurrencyId], references: [id])
  toCurrency     Currency @relation("ExchangeRateTo", fields: [toCurrencyId], references: [id])

  @@index([organizationId])
  @@index([fromCurrencyId, toCurrencyId, effectiveAt])
}

model User {
  id              String    @id @default(uuid())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?
  isActive        Boolean   @default(true)

  email           String    @unique
  password        String
  role            Role      @default(AGENT)
  accountStatus   AccountStatus @default(ACTIVE)
  statusReason    String?
  tokenVersion    Int       @default(0)
  organizationId  String
  // Selected by backend/routes/properties.ts when including assignedAgent.
  firstName       String?
  // Package 29: profileImage is the original avatar field. avatarUrl is the
  // additive, validated URL used by the self-service profile screen.
  profileImage    String?
  avatarUrl       String?
  phone           String?
  jobTitle        String?
  preferredLang   String    @default("en")
  // Package 30: monthly revenue target used by the performance leaderboard.
  monthlyTargetAmount Decimal? @db.Decimal(14, 2)
  lastLoginAt     DateTime?
  loginCount      Int       @default(0)

  organization    Organization   @relation(fields: [organizationId], references: [id])
  assignedProperties Property[]   @relation("AssignedAgentProperties")
  leads           Lead[]
  appointments    Appointment[]
  deals           Deal[]
  leadNotes       LeadNote[]
  notifications   Notification[]
  auditLogs       AuditLog[]
  uploadedDocuments Document[]      @relation("DocumentUploader")
  expenses          Expense[]
  maintenanceRequests MaintenanceRequest[] @relation("MaintenanceAssignee")
  propertyActivities PropertyActivity[]
  commissions        Commission[]
  createdMaintenanceRequests MaintenanceRequest[] @relation("MaintenanceCreator")
  uploadedPropertyImages PropertyImage[] @relation("PropertyImageUploader")
  webhookEndpointsCreated WebhookEndpoint[] @relation("WebhookEndpointCreatedBy")
  webhookEndpointsUpdated WebhookEndpoint[] @relation("WebhookEndpointUpdatedBy")

  // Package 27: optional team/branch assignment. All existing users stay unassigned.
  branchId       String?
  teamId         String?
  branch         Branch? @relation(fields: [branchId], references: [id])
  team           Team?   @relation("TeamMembers", fields: [teamId], references: [id])
  ledTeams       Team[]  @relation("TeamLeader")

  @@index([organizationId])
  @@index([role])
  @@index([accountStatus])
  @@index([branchId])
  @@index([teamId])
}

model Owner {
  id             String    @id @default(uuid())
  organizationId String?
  firstName      String?
  lastName       String?
  companyName    String?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  notes          String?
  isActive       Boolean   @default(true)
  // Package 28: revocable read-only owner portal token. The token is scoped
  // to this owner's tenant and can be rotated or cleared at any time.
  portalToken    String?   @unique
  portalEnabled  Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization   Organization? @relation(fields: [organizationId], references: [id])
  properties     Property[]
  documents      Document[]
  payouts        OwnerPayout[]

  @@index([organizationId])
  @@index([email])
  @@index([isActive, deletedAt])
  @@index([portalEnabled])
}

// Package 18: one settlement record per payout. Payouts never mutate the
// underlying deals, payments or expenses used to calculate the statement.
model OwnerPayout {
  id             String            @id @default(uuid())
  organizationId String
  ownerId        String
  amount         Decimal           @db.Decimal(14, 2)
  currency       String            @default("USD")
  status         OwnerPayoutStatus @default(PENDING)
  reference      String?
  notes          String?
  periodStart    DateTime?
  periodEnd      DateTime?
  settledAt      DateTime?
  settledById    String?
  createdById    String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  deletedAt      DateTime?

  owner          Owner             @relation(fields: [ownerId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@index([ownerId, status])
  @@index([createdAt])
}

model Property {
  id              String    @id @default(uuid())
  referenceNumber String    @unique
  title           String
  description     String?
  type            PropertyType
  status          PropertyStatus       @default(AVAILABLE)
  classification  PropertyClassification @default(SALE)
  address         String?
  city            String?
  state           String?
  country         String?
  postalCode      String?
  latitude        Decimal?  @db.Decimal(10, 7)
  longitude       Decimal?  @db.Decimal(10, 7)
  area            Decimal?  @db.Decimal(12, 2)
  areaUnit        AreaUnit  @default(SQ_M)
  bedrooms        Int       @default(0)
  bathrooms       Int       @default(0)
  floors          Int?
  yearBuilt       Int?
  condition       PropertyCondition @default(GOOD)
  price           Decimal   @default(0) @db.Decimal(14, 2)
  // Stored as an ISO code; the historical rate is chosen via ExchangeRate.
  currency        String    @default("USD")
  negotiable      Boolean   @default(false)
  featured        Boolean   @default(false)
  reservedUntil   DateTime?
  availableFrom   DateTime?
  occupancyStatus OccupancyStatus?
  operationalNotes String?
  saleRentRatio   Decimal?  @db.Decimal(12, 2)
  isActive        Boolean   @default(true)
  deletedAt       DateTime?
  publicShareToken String?  @unique
  publicShareEnabled Boolean @default(false)
  publicShareExpiresAt DateTime?
  publicShareCreatedAt DateTime?
  // Package 27: optional team/branch ownership for visibility grouping.
  branchId        String?
  teamId          String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id])

  ownerId         String?
  owner           Owner?    @relation(fields: [ownerId], references: [id])

  assignedAgentId String?
  assignedAgent   User?     @relation("AssignedAgentProperties", fields: [assignedAgentId], references: [id])

  branch          Branch?   @relation(fields: [branchId], references: [id])
  team            Team?     @relation(fields: [teamId], references: [id])

  images          PropertyImage[]
  documents       PropertyDocument[]
  activities      PropertyActivity[]
  leads           Lead[]
  appointments    Appointment[]
  deals           Deal[]
  expenses        Expense[]
  maintenanceRequests MaintenanceRequest[]
  linkedDocuments Document[]

  @@index([organizationId])
  @@index([ownerId])
  @@index([assignedAgentId])
  @@index([branchId])
  @@index([teamId])
  @@index([city])
  @@index([status])
  @@index([type])
  @@index([price])
  @@index([createdAt])
}

model PropertyImage {
  id           String    @id @default(uuid())
  propertyId   String
  url          String
  storageKey   String?
  originalName String?
  mimeType     String?
  size         Int?
  caption      String?
  isPrimary    Boolean   @default(false)
  sortOrder    Int       @default(0)
  uploadedById String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  uploadedBy User?    @relation("PropertyImageUploader", fields: [uploadedById], references: [id])

  @@index([propertyId])
  @@index([propertyId, deletedAt])
  @@index([propertyId, sortOrder])
}

model PropertyDocument {
  id           String                  @id @default(uuid())
  propertyId   String
  name         String
  url          String
  mimeType     String?
  // Existing rows keep OTHER; new rows are explicitly FLOORPLAN or BROCHURE.
  kind         PropertyAttachmentKind @default(OTHER)
  storageKey   String?
  originalName String?
  size         Int?
  sortOrder    Int                     @default(0)
  deletedAt    DateTime?
  createdAt    DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@index([propertyId])
  @@index([propertyId, deletedAt])
  @@index([propertyId, kind])
}

model PropertyActivity {
  id         String   @id @default(uuid())
  propertyId String
  userId     String?
  action     String
  details    String?
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([propertyId])
  @@index([createdAt])
}

model Lead {
  id                String        @id @default(uuid())
  firstName         String
  lastName          String?
  email             String?
  phone             String?
  status            LeadStatus    @default(NEW)
  source            String?
  notes             String?
  budgetMin         Decimal?      @db.Decimal(14, 2)
  budgetMax         Decimal?      @db.Decimal(14, 2)
  preferredType     PropertyType?
  preferredCity     String?
  preferredBedrooms Int?
  preferredAreaMin  Decimal?      @db.Decimal(12, 2)
  preferredAreaMax  Decimal?      @db.Decimal(12, 2)
  assignedToId      String?
  propertyId        String?
  // Package 27: optional team/branch grouping for hierarchy visibility.
  branchId          String?
  teamId            String?
  // Follow-up tracking: next scheduled touchpoint and most recent contact.
  nextFollowUpAt    DateTime?
  lastContactedAt   DateTime?
  // Package 15: priority is recomputed on lead writes and can be recalculated
  // on demand; the stored value powers filtering and sorting.
  priorityScore     Int           @default(0)
  priorityTier      LeadPriorityTier @default(MEDIUM)
  // Package 31: optional revocable read-only portal for this client record.
  portalToken       String?       @unique
  portalEnabled     Boolean       @default(false)
  isActive          Boolean       @default(true)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  deletedAt         DateTime?

  assignedTo     User?      @relation(fields: [assignedToId], references: [id])
  property       Property?  @relation(fields: [propertyId], references: [id])
  branch         Branch?    @relation(fields: [branchId], references: [id])
  team           Team?      @relation(fields: [teamId], references: [id])
  appointments   Appointment[]
  documents      Document[]
  deals          Deal[]
  followUpNotes  LeadNote[]

  @@index([assignedToId])
  @@index([propertyId])
  @@index([branchId])
  @@index([teamId])
  @@index([status])
  @@index([nextFollowUpAt])
  @@index([priorityScore])
  @@index([priorityTier])
  @@index([source])
  @@index([portalEnabled])
}

// Lightweight interaction log for calls and quick follow-up notes. The legacy
// free-text Lead.notes stays untouched so existing integrations keep working.
model LeadNote {
  id             String    @id @default(uuid())
  leadId         String
  authorId       String?
  body           String
  nextFollowUpAt DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  lead    Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  author  User? @relation(fields: [authorId], references: [id])

  @@index([leadId, createdAt])
  @@index([authorId])
}

model Appointment {
  id          String            @id @default(uuid())
  title       String?
  type        AppointmentType   @default(VIEWING)
  status      AppointmentStatus @default(SCHEDULED)
  startsAt    DateTime
  endsAt      DateTime?
  notes       String?
  userId      String
  propertyId  String?
  leadId      String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  user        User      @relation(fields: [userId], references: [id])
  property    Property? @relation(fields: [propertyId], references: [id])
  lead        Lead?     @relation(fields: [leadId], references: [id])

  @@index([userId])
  @@index([propertyId])
  @@index([startsAt])
}

model Deal {
  id             String     @id @default(uuid())
  referenceNumber String?   @unique
  type           DealType   @default(SALE)
  status         DealStatus @default(DRAFT)
  propertyId     String
  leadId         String?
  organizationId String
  userId         String
  // Package 27: optional team/branch grouping for hierarchy visibility.
  branchId       String?
  teamId         String?
  amount         Decimal    @default(0) @db.Decimal(14, 2)
  currency       String     @default("USD")
  exchangeRate   Decimal?   @db.Decimal(20, 8)
  baseAmount     Decimal?   @db.Decimal(14, 2)
  startedAt      DateTime?
  dueAt          DateTime?
  closedAt       DateTime?
  // Rental-only lease window and the notice period used for renewal alerts.
  leaseStartAt   DateTime?
  leaseEndAt     DateTime?
  renewalNoticeDays Int   @default(30)
  notes          String?
  // Package 16: closing checklist guardrails. A stage override is only
  // accepted from management and must always carry a written reason.
  checklistOverrideReason String?
  checklistOverriddenById String?
  checklistOverriddenAt   DateTime?
  // Package 31: optional revocable read-only portal for this deal/client.
  portalToken    String?    @unique
  portalEnabled  Boolean    @default(false)
  isActive       Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization   Organization @relation(fields: [organizationId], references: [id])
  user           User         @relation(fields: [userId], references: [id])
  property       Property     @relation(fields: [propertyId], references: [id])
  branch         Branch?      @relation(fields: [branchId], references: [id])
  team           Team?        @relation(fields: [teamId], references: [id])
  payments       Payment[]
  commissions    Commission[]
  documents      Document[]
  expenses       Expense[]
  lead           Lead?      @relation(fields: [leadId], references: [id])
  closingChecklist DealClosingChecklist[]

  @@index([organizationId])
  @@index([userId])
  @@index([propertyId])
  @@index([branchId])
  @@index([teamId])
  @@index([status])
  @@index([type, leaseEndAt])
  @@index([portalEnabled])
}

model Payment {
  id             String        @id @default(uuid())
  dealId         String
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("USD")
  status         PaymentStatus @default(PENDING)
  method         String?
  reference      String?
  notes          String?
  idempotencyKey String?       @unique
  exchangeRate   Decimal?      @db.Decimal(20, 8)
  baseAmount     Decimal?      @db.Decimal(14, 2)
  paidAt         DateTime?
  dueAt          DateTime?
  createdById    String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  deletedAt      DateTime?

  deal        Deal          @relation(fields: [dealId], references: [id])
  documents   Document[]

  @@unique([dealId, reference])
  @@index([dealId])
  @@index([dealId, dueAt])
  @@index([status])
  @@index([createdAt])
}

// Package 16: reusable closing checklist rows. Rows are created per deal and
// can be toggled independently; completion of every row gates the COMPLETED
// stage unless management supplies a documented override reason.
model DealClosingChecklist {
  id             String    @id @default(uuid())
  dealId         String
  organizationId String
  itemKey        String
  label          String
  isCompleted    Boolean   @default(false)
  completedAt    DateTime?
  completedById  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)

  @@unique([dealId, itemKey])
  @@index([organizationId])
  @@index([dealId])
}

model Expense {
  id               String        @id @default(uuid())
  propertyId       String?
  dealId           String?
  responsibleId    String?
  category         String
  description      String?
  amount           Decimal       @db.Decimal(14, 2)
  currency         String        @default("USD")
  status           ExpenseStatus @default(PENDING)
  exchangeRate     Decimal?      @db.Decimal(20, 8)
  baseAmount       Decimal?      @db.Decimal(14, 2)
  spentAt          DateTime      @default(now())
  paidAt           DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  deletedAt        DateTime?
  notes            String?
  maintenanceRequestId String?   @unique

  property    Property? @relation(fields: [propertyId], references: [id])
  deal        Deal?     @relation(fields: [dealId], references: [id])
  responsible User?     @relation(fields: [responsibleId], references: [id])
  maintenanceRequest MaintenanceRequest? @relation("MaintenanceExpense", fields: [maintenanceRequestId], references: [id])
  documents   Document[]

  @@index([propertyId])
  @@index([dealId])
  @@index([status])
  @@index([spentAt])
  @@index([maintenanceRequestId])
}

model Commission {
  id               String           @id @default(uuid())
  dealId           String
  userId           String?
  amount           Decimal          @db.Decimal(14, 2)
  currency         String           @default("USD")
  rate             Decimal?         @db.Decimal(20, 8)
  status           CommissionStatus @default(PENDING)
  notes            String?
  approvedAt       DateTime?
  paidAt           DateTime?
  paymentReference String?
  exchangeRate     Decimal?         @db.Decimal(20, 8)
  baseAmount       Decimal?         @db.Decimal(14, 2)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  deletedAt        DateTime?

  deal       Deal     @relation(fields: [dealId], references: [id])
  user       User?    @relation(fields: [userId], references: [id])

  @@index([dealId])
  @@index([userId])
  @@index([status])
}

model Notification {
  id          String    @id @default(uuid())
  userId      String
  organizationId String?
  type        String
  title       String
  message     String
  isRead      Boolean   @default(false)
  readAt      DateTime?
  entityType  String?
  entityId    String?
  actionUrl   String?
  metadata    Json?
  createdAt   DateTime  @default(now())

  user         User          @relation(fields: [userId], references: [id])
  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([userId])
  @@index([organizationId])
  @@index([userId, isRead, createdAt])
  @@index([organizationId, createdAt])
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  details    String?
  createdAt  DateTime @default(now())

  user       User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
}

model Settings {
  id             String   @id @default(uuid())
  organizationId String   @unique
  defaultLanguage String  @default("en")
  defaultCurrency String  @default("USD")
  data           Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
}

model Document {
  id            String         @id @default(uuid())
  organizationId String
  name          String
  originalName  String
  storageKey    String         @unique
  mimeType      String
  size          Int
  category      String         @default("OTHER")
  description   String?
  notes         String?
  status        DocumentStatus @default(ACTIVE)
  uploadedById  String?
  propertyId    String?
  ownerId       String?
  leadId        String?
  dealId        String?
  paymentId     String?
  expenseId     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  uploadedBy   User?         @relation("DocumentUploader", fields: [uploadedById], references: [id])
  property     Property?     @relation(fields: [propertyId], references: [id])
  owner        Owner?        @relation(fields: [ownerId], references: [id])
  lead         Lead?         @relation(fields: [leadId], references: [id])
  deal         Deal?         @relation(fields: [dealId], references: [id])
  payment      Payment?      @relation(fields: [paymentId], references: [id])
  expense      Expense?      @relation(fields: [expenseId], references: [id])

  @@index([organizationId])
  @@index([status])
  @@index([category])
  @@index([propertyId])
  @@index([dealId])
  @@index([createdAt])
}

model MaintenanceRequest {
  id             String             @id @default(uuid())
  organizationId String
  propertyId     String
  title          String
  description    String?
  priority       MaintenancePriority @default(MEDIUM)
  status         MaintenanceStatus  @default(OPEN)
  assignedToId   String?
  createdById    String?
  cost           Decimal?           @db.Decimal(14, 2)
  currency       String             @default("USD")
  dueAt          DateTime?
  completedAt    DateTime?
  recurrenceInterval MaintenanceRecurrenceInterval @default(NONE)
  nextDueAt      DateTime?
  recurrenceSourceId String?
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  property     Property     @relation(fields: [propertyId], references: [id])
  assignedTo   User?        @relation("MaintenanceAssignee", fields: [assignedToId], references: [id])
  createdBy    User?        @relation("MaintenanceCreator", fields: [createdById], references: [id])
  expenses     Expense[]    @relation("MaintenanceExpense")

  @@index([organizationId])
  @@index([propertyId])
  @@index([status])
  @@index([priority])
  @@index([createdAt])
  @@index([nextDueAt])
  @@index([recurrenceInterval])
}

// Package 22: tenant-owned outbound webhook subscriptions. Only a hash of the
// generated signing secret is stored; the raw value is returned once at
// creation and derived signing keys are never persisted.
model WebhookEndpoint {
  id             String    @id @default(uuid())
  organizationId String
  url            String
  events         String[]
  isActive       Boolean   @default(true)
  secretHash     String
  createdById    String
  updatedById    String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User          @relation("WebhookEndpointCreatedBy", fields: [createdById], references: [id])
  updatedBy    User          @relation("WebhookEndpointUpdatedBy", fields: [updatedById], references: [id])
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@index([organizationId, isActive])
  @@index([createdAt])
}

// Package 22: one row per (endpoint, event) dispatch attempt. Payloads are
// sanitized allowlists, response bodies are truncated, and no secret is stored.
model WebhookDelivery {
  id             String               @id @default(uuid())
  organizationId String
  endpointId     String
  event          String
  eventKey       String
  status         WebhookDeliveryStatus @default(PENDING)
  attempt        Int                  @default(0)
  requestUrl     String
  payload        Json
  responseStatus Int?
  responseBody   String?
  error          String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  deliveredAt    DateTime?
  nextRetryAt    DateTime?

  organization Organization    @relation(fields: [organizationId], references: [id])
  endpoint     WebhookEndpoint @relation(fields: [endpointId], references: [id])

  @@unique([organizationId, endpointId, eventKey])
  @@index([organizationId])
  @@index([endpointId])
  @@index([organizationId, status])
  @@index([organizationId, event])
  @@index([createdAt])
}
