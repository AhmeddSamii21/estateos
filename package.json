{
  "name": "goose-first-project",
  "version": "1.0.0",
  "description": "A comprehensive web-based real estate management and property locator application.",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build:api": "tsc -p tsconfig.build.json",
    "dev:api": "npm run build:api && node dist-backend/index.js",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck:backend": "tsc --noEmit -p tsconfig.backend.json",
    "typecheck:frontend": "tsc --noEmit -p tsconfig.frontend.json",
    "typecheck": "npm run typecheck:backend && npm run typecheck:frontend",
    "prisma:validate": "prisma validate --schema prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema prisma/schema.prisma",
    "test": "node --test tests/**/*.test.js",
    "test:live": "npm run build:api && node scripts/live-integration.cjs",
    "db:verify": "node scripts/verify-db.cjs",
    "db:migrate": "prisma migrate deploy --schema prisma/schema.prisma",
    "db:seed:demo": "node scripts/seed-demo.cjs",
    "verify": "npm run prisma:validate && npm run typecheck && npm run build:api && npm test && npm run build",
    "postinstall": "prisma skills sync || exit 0"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "6.4.1",
    "axios": "^1.21.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "leaflet": "^1.9.4",
    "multer": "^2.5.0",
    "pinia": "^4.1.0",
    "vue-router": "^4.6.5"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/leaflet": "^1.9.22",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/devtools": "^8.2.1",
    "prisma": "6.4.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vue": "^3.5.45"
  }
}
